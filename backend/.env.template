# ===================================================================
# BACHES RD BACKEND — TEMPLATE DE VARIABLES DE ENTORNO
# Copia este archivo como .env o configura estas variables en IntelliJ
# ===================================================================

# -------------------------------------------------------------------
# 1. AUTENTICACIÓN JWT (Obligatorio)
# -------------------------------------------------------------------
# Firma secreta de 256 bits para cifrar y verificar tokens JWT.
# Generar una firma aleatoria con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=074142544c0e3e63e4c3c1ae7b76bd8852a40e3d3a45665b9393b59f85f6881e

# Tiempo de expiración del token JWT en milisegundos (por defecto: 24 horas = 86400000 ms)
JWT_EXPIRATION=86400000


# -------------------------------------------------------------------
# 2. CLOUDINARY (Direct Upload de Fotos)
# -------------------------------------------------------------------
# Obtener credenciales en la consola de Cloudinary: https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=tu_cloud_name_aqui
CLOUDINARY_API_KEY=tu_api_key_aqui
CLOUDINARY_API_SECRET=tu_api_secret_aqui


# -------------------------------------------------------------------
# 3. BASE DE DATOS POSTGRESQL / POSTGIS (Opcional - por defecto usa Docker)
# -------------------------------------------------------------------
# Configuración por defecto apuntando al contenedor Docker (puerto 5433)
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5433/baches_rd_db
SPRING_DATASOURCE_USERNAME=baches_user
SPRING_DATASOURCE_PASSWORD=baches_password
