server {
    listen 80;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # API del backend (variable sustituida por envsubst: BACKEND_UPSTREAM).
    # Con `resolver` + variable nginx arranca aunque el upstream aún no exista
    # y resuelve el hostname por request vía el DNS embebido de Docker.
    location /api/ {
        resolver 127.0.0.11 valid=30s ipv6=off;
        set $backend_upstream ${BACKEND_UPSTREAM};
        proxy_pass $backend_upstream;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # SPA: servir index.html para rutas de react-router
    location / {
        try_files $uri $uri/ /index.html;
    }

    location ~* \.(js|css|png|jpg|jpeg|gif|svg|ico|webp|woff2?)$ {
        expires 30d;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }
}
